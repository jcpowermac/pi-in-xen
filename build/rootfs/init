#!/bin/busybox sh
# Alpine initramfs init script for pi agent Xen PVH VM
# PID 1: mount pseudo-fs, configure network, run pi agent, shutdown on exit

# Mount pseudo-filesystems
mount -t proc none /proc
mount -t sysfs none /sys
mount -t devtmpfs none /dev

# Create console device (Xen PV: hvc0)
mknod /dev/hvc0 c 226 0 2>/dev/null || true

# Parse network from kernel cmdline
CMDLINE=$(cat /proc/cmdline)
IP=$(echo "$CMDLINE" | grep -o 'ip=[^ ]*' | cut -d= -f2)

# Network config (Xen PV: static, no DHCP)
if [ -n "$IP" ]; then
    ip link set lo up
    ip addr add "$IP" dev eth0
    ip link set eth0 up
    # Gateway = last octet replaced with 1
    GATEWAY=$(echo "$IP" | awk -F'[./]' '{print $1"."$2"."$3".1"}')
    ip route add default via "$GATEWAY"
fi

# Wait for console connection before starting pi. pi caches the terminal
# size at startup; without this it gets 0x0 (no console attached) and
# stays cramped until restarted. qlvm vm console sets the correct size
# via TIOCSWINSZ when the user connects, so we poll until it's non-zero.
# Timeout after 30s so the VM is still usable if no one connects.
echo "Waiting for console connection..."
i=0
while [ $i -lt 30 ]; do
    size=$(stty -F /dev/hvc0 size 2>/dev/null)
    rows=$(echo "$size" | cut -d' ' -f1)
    cols=$(echo "$size" | cut -d' ' -f2)
    if [ "$rows" -gt 0 ] && [ "$cols" -gt 0 ] 2>/dev/null; then
        echo "Console connected (${rows}x${cols}), starting pi"
        break
    fi
    sleep 1
    i=$((i + 1))
done
if [ $i -ge 30 ]; then
    echo "No console connection after 30s, starting pi anyway"
fi

# Run pi agent as a child (NOT exec — init must stay PID 1).
# When pi exits (quit, crash, Ctrl+] escape), drop to shell for debugging.
cd /workspace
su - piagent -c "/usr/local/bin/pi"
rc=$?

echo "pi agent exited (rc=$rc), dropping to shell"
echo "Inspect as needed, then run: poweroff"
exec su - piagent -c "/bin/busybox sh"
