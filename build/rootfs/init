#!/bin/busybox sh
# Alpine initramfs init script for pi agent Xen PVH VM
# PID 1: mount pseudo-fs, configure network, run pi agent, shutdown on exit

# Mount pseudo-filesystems
mount -t proc none /proc
mount -t sysfs none /sys
mount -t devtmpfs none /dev
# tmux (pi's pty host) needs /dev/ptmx, which devtmpfs alone does not
# provide: mount devpts and materialize the ptmx node.
mkdir -p /dev/pts
mount -t devpts none /dev/pts 2>/dev/null || true
mknod -m 666 /dev/ptmx c 5 2 2>/dev/null || ln -sf pts/ptmx /dev/ptmx 2>/dev/null || true
# /tmp is a plain initramfs dir (root:755); node's compile cache and pi
# need it writable by piagent. A tmpfs is the standard initramfs answer.
mount -t tmpfs -m 1777 none /tmp 2>/dev/null || chmod 1777 /tmp

# Create console device (Xen PV: hvc0)
mknod /dev/hvc0 c 226 0 2>/dev/null || true

# Parse network from kernel cmdline
CMDLINE=$(cat /proc/cmdline)
IP=$(echo "$CMDLINE" | grep -o 'ip=[^ ]*' | cut -d= -f2)

# Network config (Xen PV: static, no DHCP)
if [ -n "$IP" ]; then
    ip link set lo up
    ip addr add "$IP" dev eth0
    ip link set eth0 up
    # Gateway = last octet replaced with 1
    GATEWAY=$(echo "$IP" | awk -F'[./]' '{print $1"."$2"."$3".1"}')
    ip route add default via "$GATEWAY"
fi

# Run pi under tmux (NOT exec — init must stay PID 1). tmux decouples
# the TUI's terminal size from the console attach lifecycle: pi starts
# immediately, no console client needed at boot, and the session
# survives detach/reconnect.
#
# The console itself is bridged through conmux: the Xen console ring
# (hvc0) is a pure byte stream with no terminal-size channel, so a tmux
# client attached directly to hvc0 sees a 0x0 winsize and falls back to
# 80x25. conmux hands the child a pty instead and applies the in-band
# size marker (DCS 8;rows;cols ST) that `qlvm vm console` pushes on
# attach and on every local resize; the pty SIGWINCH reflows pi.
# TERM is set explicitly: the guest has no login env, and a full-screen
# TUI needs a sane terminal type.
export TERM=xterm-256color
cd /workspace
tmux new-session -d -s pi "su - piagent -c /usr/local/bin/pi"
# Bridge the console (hvc0) to a pty; returns when the attach dies
# (pi exited, or the session died).
conmux tmux attach-session -t pi
rc=$?

echo "pi agent exited (rc=$rc), dropping to shell"
echo "Inspect as needed. Run 'poweroff' or press Ctrl+D to power off."
# No exec: the shell must not replace PID 1. If it did, Ctrl+D would
# kill init and panic the kernel. When the shell exits, power off.
# (Also through conmux: the shell then has a real tty/ctty — running it
# straight on hvc0 gives it no controlling terminal and stty/tty break.)
conmux su - piagent -c "/bin/busybox sh"
echo "shell exited, powering off"
poweroff
